{
  "name": "medfin-data-cloud",
  "version": "0.1.0",
  "description": "Minimal NestJS Acute ingestion service with Prisma and MySQL.",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose stop mysql",
    "reset:test-state": "node scripts/reset-test-state.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "test": "echo \"Tests are not set up yet\"",
    "db:repository-indexes": "docker exec -i medfin-data-cloud-mysql mysql -uroot -proot datacloud < scripts/sql/repository_record_invoice_date_index.sql"
  },
  "keywords": [
    "nestjs",
    "prisma",
    "mysql",
    "acute"
  ],
  "author": "",
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.1",
    "@prisma/client": "^6.17.1",
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cron": "^4.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "prisma": "^6.17.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
