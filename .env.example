PORT=3000
NODE_ENV=development
DATABASE_URL=mysql://datacloud:datacloud@127.0.0.1:3306/datacloud

ACUTE_STAGE_BASE_URL=https://api.acute.fi/LA2218_Euromedfin_Koe_REST/v1
