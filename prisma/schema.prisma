generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SyncMode {
  full
  incremental
}

enum SyncRunStatus {
  success
  failed
}

enum ReportExecutionStatus {
  running
  success
  failed
}

enum ReportExecutionMode {
  ai_direct
}

model RepositoryRecord {
  id              String   @id @default(cuid())
  entityType      String
  externalId      String
  payload         Json
  sourceUpdatedAt DateTime?
  checksum        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityType, externalId])
  @@index([entityType, sourceUpdatedAt])
}

model EntitySyncState {
  entityKey            String   @id
  lastRunStartedAt     DateTime?
  lastRunCompletedAt   DateTime?
  lastSuccessfulSyncAt DateTime?
  lastSyncMode         SyncMode?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SyncRun {
  id            String        @id @default(cuid())
  entityKey     String
  status        SyncRunStatus
  mode          SyncMode
  fetchedCount  Int           @default(0)
  upsertedCount Int           @default(0)
  startedAt     DateTime
  finishedAt    DateTime?
  message       String?       @db.Text
  syncContext   Json?
  createdAt     DateTime      @default(now())

  @@index([entityKey, startedAt])
}

model ReportExecution {
  id            String                @id @default(cuid())
  entityKey     String
  mode          ReportExecutionMode
  prompt        String                @db.Text
  filters       Json?
  options       Json?
  inputRowCount Int                   @default(0)
  inputSample   Json?
  status        ReportExecutionStatus
  result        Json?
  errorMessage  String?               @db.Text
  createdAt     DateTime              @default(now())
  finishedAt    DateTime?

  @@index([entityKey, createdAt])
  @@index([status, createdAt])
}
