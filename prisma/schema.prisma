generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SyncMode {
  full
  incremental
}

enum SyncRunStatus {
  success
  failed
}

enum SyncFlowType {
  raw
  stage
}

enum ReportExecutionStatus {
  running
  success
  failed
}

enum ReportExecutionMode {
  ai_direct
}

model RepositoryRecord {
  id              String   @id @default(cuid())
  entityType      String
  externalId      String
  payload         Json
  sourceUpdatedAt DateTime?
  checksum        String?
  stagingNeeded   Boolean  @default(true)
  lastStagedAt    DateTime?
  lastStagedChecksum String?
  stageError      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityType, externalId])
  @@index([entityType, sourceUpdatedAt])
  @@index([entityType, stagingNeeded, updatedAt])
  @@index([entityType, stagingNeeded, id])
}

model EnumLookup {
  id        String   @id @default(cuid())
  domainKey String   @map("domain_key")
  entityKey String   @map("entity_key")
  fieldKey  String   @map("field_key")
  codeInt   Int?     @map("code_int")
  codeText  String?  @map("code_text")
  codeLabel String   @map("code_label")
  sortOrder Int?     @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([domainKey, codeInt])
  @@unique([domainKey, codeText])
  @@index([entityKey, fieldKey])
  @@map("enum_lookup")
}

