generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SyncMode {
  full
  incremental
}

enum SyncRunStatus {
  success
  failed
}

enum SyncFlowType {
  raw
  stage
}

enum ReportExecutionStatus {
  running
  success
  failed
}

enum ReportExecutionMode {
  ai_direct
}

model RepositoryRecord {
  id              String   @id @default(cuid())
  entityType      String
  externalId      String
  payload         Json
  sourceUpdatedAt DateTime?
  checksum        String?
  stagingNeeded   Boolean  @default(true)
  lastStagedAt    DateTime?
  lastStagedChecksum String?
  stageError      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityType, externalId])
  @@index([entityType, sourceUpdatedAt])
  @@index([entityType, stagingNeeded, updatedAt])
}

model StgClient {
  id                    String   @id @default(cuid())
  externalId            String   @unique
  client                String?
  birthDate             DateTime?
  gender                String?
  homeUnit              String?
  city                  String?
  municipality          String?
  municipalityCode      String?
  countryId             String?
  clientType            String?
  endDate               DateTime?
  deathDate             DateTime?
  latestSaveDate        DateTime?
  latestSavePersonnelId Int?
  extraData             Json?
  sourceUpdatedAt       DateTime?
  checksum              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([clientType])
  @@index([municipality])
  @@index([latestSaveDate])
  @@map("stg_client")
}

model StgOrganisation {
  id                    String   @id @default(cuid())
  externalId            String   @unique
  orgId                 Int?
  parentOrgId           Int?
  orgName               String?
  streetCity            String?
  busRegno              String?
  latestSaveDate        DateTime?
  extraData             Json?
  sourceUpdatedAt       DateTime?
  checksum              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([orgId])
  @@index([parentOrgId])
  @@index([latestSaveDate])
  @@map("stg_organisation")
}

model StgEmployer {
  id                               String   @id @default(cuid())
  externalId                       String   @unique
  employer                         String?
  clientId                         Int?
  orgId                            Int?
  startDate                        DateTime?
  endDate                          DateTime?
  mainEmployer                     Boolean?
  profDescr                        String?
  extraData                        Json?
  sourceUpdatedAt                  DateTime?
  checksum                         String?
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  @@index([clientId])
  @@index([orgId])
  @@index([mainEmployer])
  @@map("stg_employer")
}

model StgPersonnel {
  id                String   @id @default(cuid())
  externalId        String   @unique
  personnelId       Int?
  activated         Boolean?
  deleted           Boolean?
  personnelState    String?
  personnelCategory String?
  defaultUnitId     Int?
  extraData         Json?
  sourceUpdatedAt   DateTime?
  checksum          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([personnelId])
  @@index([personnelState])
  @@index([personnelCategory])
  @@map("stg_personnel")
}

model StgInvoice {
  id              String   @id @default(cuid())
  externalId      String   @unique
  invoice         String?
  invoiceId       Int?
  personnelId     Int?
  invoiceDate     DateTime?
  modifiedDate    DateTime?
  invoiceNbr      Int?
  unitId          Int?
  payerClientId   Int?
  payerOrgId      Int?
  totalAmount     String?
  invoiceStatusId Int?
  extraData       Json?
  sourceUpdatedAt DateTime?
  checksum        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([invoiceId])
  @@index([invoiceDate])
  @@index([modifiedDate])
  @@index([payerClientId])
  @@index([payerOrgId])
  @@map("stg_invoice")
}

model StgInvoiceEvent {
  id           String   @id @default(cuid())
  externalId   String   @unique
  eventPayerId Int?
  created      DateTime?
  payerOrgId   Int?
  clientId     Int?
  amountShare  String?
  invoiceId    Int?
  price        String?
  extraData    Json?
  sourceUpdatedAt DateTime?
  checksum     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([eventPayerId])
  @@index([created])
  @@index([invoiceId])
  @@index([clientId])
  @@index([payerOrgId])
  @@map("stg_invoice_event")
}

model EntitySyncState {
  entityKey            String   @id
  lastRunStartedAt     DateTime?
  lastRunCompletedAt   DateTime?
  lastSuccessfulSyncAt DateTime?
  lastSyncMode         SyncMode?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SyncRun {
  id            String        @id @default(cuid())
  entityKey     String
  flowType      SyncFlowType  @default(raw)
  status        SyncRunStatus
  mode          SyncMode
  fetchedCount  Int           @default(0)
  upsertedCount Int           @default(0)
  startedAt     DateTime
  finishedAt    DateTime?
  message       String?       @db.Text
  syncContext   Json?
  createdAt     DateTime      @default(now())

  @@index([entityKey, flowType, startedAt])
}

model ReportExecution {
  id            String                @id @default(cuid())
  entityKey     String
  mode          ReportExecutionMode
  prompt        String                @db.Text
  filters       Json?
  options       Json?
  inputRowCount Int                   @default(0)
  inputSample   Json?
  status        ReportExecutionStatus
  result        Json?
  errorMessage  String?               @db.Text
  createdAt     DateTime              @default(now())
  finishedAt    DateTime?

  @@index([entityKey, createdAt])
  @@index([status, createdAt])
}
